// Debug version of pitch extraction to trace the issue
#include <Rcpp.h>
#include "praat_xptr_utils.h"
#include "praat_types.h"

#include "praat.github.io/fon/Pitch.h"
#include "praat.github.io/fon/Sound.h"
#include "praat.github.io/fon/Sound_to_Pitch.h"

using namespace Rcpp;

// [[Rcpp::export(.pitch_debug_sound_to_pitch)]]
Rcpp::XPtr<structPitch> pitch_debug_sound_to_pitch(
    Rcpp::XPtr<structSound> sound_xptr,
    double time_step,
    double pitch_floor,
    double pitch_ceiling
) {
    structSound* sound = sound_xptr.get();
    if (!sound) stop("Invalid Sound pointer");
    
    Rcpp::Rcout << "=== DEBUG: Sound_to_Pitch ===\n";
    Rcpp::Rcout << "Sound properties:\n";
    Rcpp::Rcout << "  nx (samples) = " << sound->nx << "\n";
    Rcpp::Rcout << "  ny (channels) = " << sound->ny << "\n";
    Rcpp::Rcout << "  dx (sample period) = " << sound->dx << "\n";
    Rcpp::Rcout << "  xmin = " << sound->xmin << ", xmax = " << sound->xmax << "\n";
    Rcpp::Rcout << "  Duration = " << (sound->xmax - sound->xmin) << " s\n";
    
    // Check first few samples
    Rcpp::Rcout << "First 5 samples (channel 1): ";
    for (int i = 1; i <= std::min(5, (int)sound->nx); i++) {
        Rcpp::Rcout << sound->z[1][i] << " ";
    }
    Rcpp::Rcout << "\n";
    
    Rcpp::Rcout << "Pitch parameters:\n";
    Rcpp::Rcout << "  time_step = " << time_step << "\n";
    Rcpp::Rcout << "  pitch_floor = " << pitch_floor << " Hz\n";
    Rcpp::Rcout << "  pitch_ceiling = " << pitch_ceiling << " Hz\n";
    
    try {
        Rcpp::Rcout << "Calling Sound_to_Pitch...\n";
        autoPitch pitch = Sound_to_Pitch(sound, time_step, pitch_floor, pitch_ceiling);
        
        Rcpp::Rcout << "Pitch created:\n";
        Rcpp::Rcout << "  nx (frames) = " << pitch->nx << "\n";
        Rcpp::Rcout << "  dx (time step) = " << pitch->dx << "\n";
        Rcpp::Rcout << "  maxnCandidates = " << pitch->maxnCandidates << "\n";
        
        // Check first frame
        if (pitch->nx > 0) {
            auto& frame1 = pitch->frames[1];
            Rcpp::Rcout << "First frame:\n";
            Rcpp::Rcout << "  intensity = " << frame1.intensity << "\n";
            Rcpp::Rcout << "  nCandidates = " << frame1.nCandidates << "\n";
            if (frame1.nCandidates > 0) {
                Rcpp::Rcout << "  candidate[1].frequency = " << frame1.candidates[1].frequency << " Hz\n";
                Rcpp::Rcout << "  candidate[1].strength = " << frame1.candidates[1].strength << "\n";
            }
        }
        
        // Count voiced
        integer voiced_count = 0;
        for (integer i = 1; i <= pitch->nx; i++) {
            if (pitch->frames[i].nCandidates > 0 && pitch->frames[i].candidates[1].frequency > 0) {
                voiced_count++;
            }
        }
        Rcpp::Rcout << "Voiced frames = " << voiced_count << " / " << pitch->nx << "\n";
        
        return create_xptr_from_auto<structPitch>(pitch);
        
    } catch (MelderError) {
        Melder_clearError();
        stop("Failed to extract pitch (debug)");
    }
}
