  pitch_floor = 60,
  pitch_ceiling = 333.3,
  delta_f0 = 0.05,
  interpolation = c("parabolic", "none", "cubic", "sinc70", "sinc700"),
  quefrency_range_start = 0.001,
  quefrency_range_end = 0.05,
  trend_line_type = c("straight", "exponential decay"),
  fit_method = c("robust", "least squares", "robust slow")
)}\if{html}{\out{</div>}}
}

