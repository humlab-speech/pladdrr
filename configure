#!/bin/sh

# Configure script for pladdrr package
# Detects: RcppXsimd (SIMD support), GSL (GNU Scientific Library)

# ---- RcppXsimd check ----
# RcppXsimd is a LinkingTo dependency, so its headers must be present for the
# build to run at all; -DHAVE_XSIMD is set unconditionally in Makevars.in. This
# check exists only to turn a wall of missing-header errors into one clear message.

echo "Checking for RcppXsimd..."
if ! "${R_HOME}/bin/Rscript" -e "if (!requireNamespace('RcppXsimd', quietly = TRUE)) quit(status = 1)" 2>/dev/null; then
  echo "  ERROR: RcppXsimd not found, but it is a LinkingTo dependency."
  echo "  Install it first: install.packages('RcppXsimd')"
  exit 1
fi
echo "  RcppXsimd found"

# ---- GSL detection ----
# Try gsl-config first (standard), then pkg-config, then fallback

GSL_CFLAGS=""
GSL_LIBS=""

echo "Checking for GSL (GNU Scientific Library)..."

if command -v gsl-config >/dev/null 2>&1; then
  GSL_CFLAGS=$(gsl-config --cflags 2>/dev/null)
  GSL_LIBS=$(gsl-config --libs 2>/dev/null)
  GSL_VERSION=$(gsl-config --version 2>/dev/null)
  echo "  Found GSL ${GSL_VERSION} via gsl-config"
  echo "    CFLAGS: ${GSL_CFLAGS}"
  echo "    LIBS:   ${GSL_LIBS}"
elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists gsl 2>/dev/null; then
  GSL_CFLAGS=$(pkg-config --cflags gsl 2>/dev/null)
  GSL_LIBS=$(pkg-config --libs gsl 2>/dev/null)
  GSL_VERSION=$(pkg-config --modversion gsl 2>/dev/null)
  echo "  Found GSL ${GSL_VERSION} via pkg-config"
  echo "    CFLAGS: ${GSL_CFLAGS}"
  echo "    LIBS:   ${GSL_LIBS}"
else
  # Fallback: try standard -lgsl -lgslcblas (works if headers are in standard paths)
  echo "  gsl-config and pkg-config not found, using fallback: -lgsl -lgslcblas"
  echo "  If compilation fails, install GSL development package:"
  echo "    macOS:   brew install gsl"
  echo "    Ubuntu:  sudo apt-get install libgsl-dev"
  echo "    Fedora:  sudo dnf install gsl-devel"
  GSL_LIBS="-lgsl -lgslcblas"
fi

# Verify GSL is actually usable (optional — quick compile test)
if [ -n "${GSL_LIBS}" ]; then
  echo "  GSL configuration OK"
else
  echo "  WARNING: GSL not detected. Build may fail."
  echo "  Install GSL: brew install gsl (macOS) or apt-get install libgsl-dev (Ubuntu)"
fi

# ---- Substitute into Makevars ----

sed -e "s|@GSL_CFLAGS@|${GSL_CFLAGS}|" \
    -e "s|@GSL_LIBS@|${GSL_LIBS}|" \
    src/Makevars.in > src/Makevars

# ---- Build integrity guards (non-fatal warnings) ----

if [ -x tools/check_callentries.sh ]; then
  tools/check_callentries.sh || { echo "  ERROR: CallEntries patch could not be applied — pladdrr would fail to load. See PRAAT_MODIFICATIONS v4.8.32."; exit 1; }
fi

if [ -x tools/check_doc_version.sh ]; then
  tools/check_doc_version.sh || echo "  WARNING: agent-facing docs lag DESCRIPTION version (design principle 5)."
fi

echo "Configuration complete"
exit 0
