\arguments{
\item{object}{A pladdrr S3 analysis object (Sound, Pitch, Formant,
Intensity, Spectrogram, Spectrum, Ltas, Harmonicity, PointProcess,
PowerCepstrum, or TextGrid)}

\item{from_time}{Start time in seconds (NULL = from beginning)}

\item{to_time}{End time in seconds (NULL = to end)}

\item{color}{Line color (default: "steelblue")}

\item{...}{Additional arguments passed to geom_line}

\item{show_voicing}{Color by voicing strength (default: FALSE)}

\item{geom}{For Pitch: type of geometry ("line" or "point")}

\item{max_formant}{Maximum formant number to display (default: 3).}

\item{colors}{Colors for each formant track (default: auto).}

\item{from_freq}{Start frequency in Hz}

\item{to_freq}{End frequency in Hz}

\item{dynamic_range}{Dynamic range in dB (default: 70)}

\item{log_freq}{Use logarithmic frequency scale (default: FALSE)}

\item{ymin}{For PointProcess: minimum y value for vertical lines (default: 0)}

\item{ymax}{For PointProcess: maximum y value for vertical lines (default: 1)}

\item{from_quefrency}{Start quefrency in seconds}

\item{to_quefrency}{End quefrency in seconds}

\item{mark_peak}{Mark the cepstral peak (default: TRUE)}

\item{tier}{Tier number or name to display (default: 1)}

\item{alpha}{Fill transparency (default: 0.3)}

\item{garnish}{Whether to add a title and axis labels (default TRUE).}

\item{time_step}{Sampling interval in seconds, only used when style="line"
(default: 0.005).}

\item{style}{"speckle" (default, matches Praat's FormantTier_speckle: plots
the
 tier's own stored points, unconnected) or "line" (interpolates on a
 time_step grid and connects with a line — not Praat's default view).}

\item{show_candidates}{Logical. Overlay candidate paths (default: TRUE).}

\item{show_phase}{Include phase as separate panel (default: FALSE).}

\item{power}{If TRUE, plot as PowerCepstrum (dB). Default FALSE matches
Praat's default `Cepstrum_drawLinear` (raw signed cepstrum, linear scale).}

\item{quefrency_range}{Optional `c(min, max)` quefrency range to display
(PowerCepstrogram); NULL shows the full range.}

\item{coefficient_range}{Range of coefficients to display (e.g. 1:12).}

\item{x_col}{Column name for x-axis (default: auto-detect).}

\item{y_col}{Column name for y-axis (default: auto-detect).}

\item{fill_col}{Column name for fill (default: auto-detect).}

\item{type}{For PCA: "scree" (variance explained), "scores"
(component scores), or "both" (combined via patchwork).}

\item{from_track, to_track}{Track index range to display (FormantModeler).}

\item{alpha_path}{Alpha for warping path line (default: 0.8).}

\item{fill_polygon}{Fill the polygon interior (default: FALSE).}

\item{fill_color}{Fill color for closed shapes (Polygon); distinct from
`fill_col`, which selects a data column to map to a continuous fill scale.}

\item{plot_type}{Plot style selector (VocalTract).}

\item{frame}{Time or frame index to extract LPC spectrum at.}

\item{formant_type}{Type of formant to plot: "oral", "nasal", "frication",
"tracheal", "delta", or (autoplot.KlattGrid only) "all".}
}
\value{
A ggplot2 object
}
\description{
ggplot2-style autoplot() and autolayer() methods for Praat objects.
These provide a tidyverse-idiomatic interface for plotting, allowing
flexible composition of multi-object visualizations.
}
\details{
The autoplot/autolayer pattern enables flexible plot composition:
\itemize{
  \item \code{autoplot(object)} - Creates a complete ggplot
  \item \code{autolayer(object)} - Returns a layer to add to existing plots
}

This allows combining multiple objects:
\preformatted{
autoplot(spectrogram) +
  autolayer(formant, max_formant = 3) +
  autolayer(pitch, color = "blue")
}
}
\examples{
sound <- Sound$create_tone(frequency = 220, duration = 0.5, sampling_rate =
 16000)
p <- ggplot2::autoplot(sound)

pitch <- sound$to_pitch()
p2 <- ggplot2::autoplot(pitch)

}
