# Minimal Makefile to build required CLAPACK sources for speaker package

# F2C library sources
F2C_SRC = F2CLIBS/libf2c/abort_.c F2CLIBS/libf2c/d_sign.c F2CLIBS/libf2c/pow_dd.c \
          F2CLIBS/libf2c/pow_di.c F2CLIBS/libf2c/s_cat.c F2CLIBS/libf2c/s_cmp.c \
          F2CLIBS/libf2c/s_copy.c

# Core BLAS level 1
BLAS1_SRC = BLAS/SRC/daxpy.c BLAS/SRC/dcopy.c BLAS/SRC/ddot.c BLAS/SRC/dnrm2.c \
            BLAS/SRC/drot.c BLAS/SRC/drotg.c BLAS/SRC/dscal.c BLAS/SRC/dswap.c \
            BLAS/SRC/idamax.c BLAS/SRC/dasum.c

# Core BLAS level 2
BLAS2_SRC = BLAS/SRC/dgemv.c BLAS/SRC/dger.c BLAS/SRC/dsymv.c BLAS/SRC/dsyr2.c \
            BLAS/SRC/dtrmv.c BLAS/SRC/dtrsv.c

# Core BLAS level 3
BLAS3_SRC = BLAS/SRC/dgemm.c BLAS/SRC/dsyrk.c BLAS/SRC/dtrmm.c BLAS/SRC/dtrsm.c

# Core LAPACK (only what Praat needs)
LAPACK_SRC = SRC/dlamch.c SRC/dgeev.c SRC/dgesvd.c SRC/dggsvd.c SRC/dhseqr.c \
             SRC/dpotf2.c SRC/dsyev.c SRC/dtrtri.c SRC/dtrti2.c SRC/dsytrf.c SRC/dsytri.c

ALL_SRC = $(F2C_SRC) $(BLAS1_SRC) $(BLAS2_SRC) $(BLAS3_SRC) $(LAPACK_SRC)
ALL_OBJ = $(ALL_SRC:.c=.o)

.PHONY: all clean

all: $(ALL_OBJ)

%.o: %.c
$(CC) $(CFLAGS) -I./INCLUDE -I./F2CLIBS/libf2c -c $< -o $@

clean:
rm -f $(ALL_OBJ)
