# Editor/VCS/OS metadata
^.*\.Rproj$
^\.Rproj\.user$
^\.git$
^\.gitignore$
^\.github$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^\.DS_Store$
^\.vscode$
^\.idea$
^\.claude$
^\.specify$
^\.serena$
^\.pi$
^\.superpowers$
^\.ruff_cache$

# CI configs not used by R CMD check
^\.travis\.yml$
^\.gitlab-ci\.yml$
^appveyor\.yml$
^codecov\.yml$

# Dev-only trees: notes, planning docs, benchmark/cross-validation harnesses.
# The Praat cross-validation harness needs an external Praat install and the
# plabench Python package, so it cannot run under R CMD check.
^dev/
^results$
^plans$
^specs$
^inst/benchmarks$
^docs$
^docs-archive$
^pkgdown$
^_pkgdown\.yml$
^revdep$

# Repo docs not meant for the built package
^README\.Rmd$
^LICENSE\.md$
^CLAUDE\.md$
^NEWS-archive\.md$
^cran-comments\.md$
^TODO\.md$

# Repository metadata: recognised by GitHub/Zenodo, non-standard at package top level
^codemeta\.json$
^CITATION\.cff$
^pladdrr_logo\.svg$

# Stray dev-scratch scripts/output that occasionally land at top level
^.*\.sh$
^.*\.log$
^.*\.py$
^test_.*\.R$
^verify_.*\.R$
^final_.*\.R$
^create_test_audio\.R$
^graphify-out$

# Build artefacts
^doc$
^Meta$
^\.Rcheck$
^pladdrr\.Rcheck$
^pladdrr_.*\.tar\.gz$
^src/Makevars$

# --- src/praat.github.io: keep only what's compiled or on an -I include path ---
^src/praat\.github\.io/docs/
^src/praat\.github\.io/generate/
^src/praat\.github\.io/test/
^src/praat\.github\.io/artsynth/
^src/praat\.github\.io/dwtest/
^src/praat\.github\.io/EEG/
^src/praat\.github\.io/FFNet/
^src/praat\.github\.io/gram/
^src/praat\.github\.io/main/
^src/praat\.github\.io/makefiles/
^src/praat\.github\.io/\.git
manual_.*\.cpp$

# Bundled external libraries: keep the referenced headers, drop the (stubbed) sources
^src/praat\.github\.io/external/.*\.(c|cc|cpp)$

# pffft: submodule that is not compiled, not on any -I path, and referenced by
# no source file. Shipping it would distribute unattributed, unused C sources.
^src/pffft/

# pocketfft: only pocketfft_hdronly.h is used (by dwsys/NUMFourier.cpp);
# the demo and build files are not. LICENSE.md and README.md are kept.
^src/pocketfft/\.git$
^src/pocketfft/pocketfft_demo\.cc$
^src/pocketfft/meson\.build$

^src/clapack/\.git$

# Compiled/editor-junk build artefacts anywhere under src/
^src/.*\.(o|o\.tmp|so|la|exe|backup.*|bak.*|tmp.*|before.*|beforesed|dup|fix|future|rcpp|static|init|with_duplicate|clang-format)$
