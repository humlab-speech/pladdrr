}

// ============================================================================
// Tier Management
// ============================================================================

// [[Rcpp::export(.textgrid_insert_interval_tier)]]
void textgrid_insert_interval_tier(Rcpp::XPtr<structTextGrid> xptr, int position, std::string name) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    try {
        autoIntervalTier newTier = IntervalTier_create(xptr->xmin, xptr->xmax);
        Thing_setName(newTier.get(), Melder_peek8to32(name.c_str()));
        xptr->tiers -> addItemAtPosition_move (newTier.move(), position);
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to insert interval tier");
    }
}

// [[Rcpp::export(.textgrid_insert_point_tier)]]
void textgrid_insert_point_tier(Rcpp::XPtr<structTextGrid> xptr, int position, std::string name) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    try {
        autoTextTier newTier = TextTier_create(xptr->xmin, xptr->xmax);
        Thing_setName(newTier.get(), Melder_peek8to32(name.c_str()));
        xptr->tiers -> addItemAtPosition_move (newTier.move(), position);
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to insert point tier");
    }
}

// [[Rcpp::export(.textgrid_remove_tier)]]
void textgrid_remove_tier(Rcpp::XPtr<structTextGrid> xptr, int tier_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    try {
        xptr->tiers -> removeItem (tier_number);
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to remove tier");
    }
}

// ============================================================================
// TextGrid-Sound Integration
// ============================================================================

// [[Rcpp::export(.textgrid_extract_intervals_where)]]
Rcpp::List textgrid_extract_intervals_where(
    Rcpp::XPtr<structTextGrid> tg_ptr,
    Rcpp::XPtr<structSound> sound_ptr,
    int tier_number,
    bool match_value,
    std::string match_text
) {
    if (!tg_ptr) Rcpp::stop("Invalid TextGrid pointer");
    if (!sound_ptr) Rcpp::stop("Invalid Sound pointer");
    if (tier_number < 1 || tier_number > tg_ptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    
    try {
        Function tier = tg_ptr->tiers->at [tier_number];
        if (!Thing_isa(tier, classIntervalTier)) {
            Rcpp::stop("Tier is not an IntervalTier");
        }
        
        IntervalTier intervalTier = (IntervalTier) tier;
        conststring32 match_text_u32 = Melder_peek8to32(match_text.c_str());
        
        // Count matching intervals
        integer n_matches = 0;
        for (integer i = 1; i <= intervalTier->intervals.size; i++) {
            TextInterval interval = intervalTier->intervals.at [i];
            bool matches = (match_value == (Melder_equ(interval->text.get(), match_text_u32)));
            if (matches) n_matches++;
        }
        
        // Extract matching sounds
        Rcpp::List sounds(n_matches);
        integer match_idx = 0;
        for (integer i = 1; i <= intervalTier->intervals.size; i++) {
            TextInterval interval = intervalTier->intervals.at [i];
            bool matches = (match_value == (Melder_equ(interval->text.get(), match_text_u32)));
            
            if (matches) {
                autoSound extracted = Sound_extractPart(
                    sound_ptr.get(),
                    interval->xmin,
                    interval->xmax,
                    kSound_windowShape::RECTANGULAR,
                    1.0,
                    false
                );
                Rcpp::XPtr<structSound> sound_xptr = create_xptr_from_auto<structSound>(extracted);
                sounds[match_idx++] = sound_xptr;
            }
        }
        
        return sounds;
        
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to extract intervals");
    }
}
