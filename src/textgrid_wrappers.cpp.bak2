// [[Rcpp::export(.textgrid_get_interval_text)]]
std::string textgrid_get_interval_text(Rcpp::XPtr<structTextGrid> xptr, int tier_number, int interval_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    if (!Thing_isa(tier, classIntervalTier)) {
        Rcpp::stop("Tier is not an IntervalTier");
    }
    IntervalTier intervalTier = (IntervalTier) tier;
    if (interval_number < 1 || interval_number > intervalTier->intervals.size) {
        Rcpp::stop("Interval number out of range");
    }
    TextInterval interval = intervalTier->intervals.at [interval_number];
    const char32* text = interval->text.get();
    
    // Convert char32 to UTF-8
    std::string result;
    if (text) {
        for (const char32* p = text; *p; p++) {
            char32 c = *p;
            if (c < 0x80) {
                result += static_cast<char>(c);
            } else if (c < 0x800) {
                result += static_cast<char>(0xC0 | (c >> 6));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else if (c < 0x10000) {
                result += static_cast<char>(0xE0 | (c >> 12));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else {
                result += static_cast<char>(0xF0 | (c >> 18));
                result += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            }
        }
    }
    return result;
}

// [[Rcpp::export(.textgrid_set_interval_text)]]
void textgrid_set_interval_text(Rcpp::XPtr<structTextGrid> xptr, int tier_number, int interval_number, std::string text) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    if (!Thing_isa(tier, classIntervalTier)) {
        Rcpp::stop("Tier is not an IntervalTier");
    }
    IntervalTier intervalTier = (IntervalTier) tier;
    if (interval_number < 1 || interval_number > intervalTier->intervals.size) {
        Rcpp::stop("Interval number out of range");
    }
    try {
        TextInterval interval = intervalTier->intervals.at [interval_number];
        TextInterval_setText(interval, Melder_peek8to32(text.c_str()));
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to set interval text");
    }
}

