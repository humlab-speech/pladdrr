// [[Rcpp::export(.textgrid_get_point_text)]]
std::string textgrid_get_point_text(Rcpp::XPtr<structTextGrid> xptr, int tier_number, int point_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    if (!Thing_isa(tier, classTextTier)) {
        Rcpp::stop("Tier is not a TextTier (point tier)");
    }
    TextTier textTier = (TextTier) tier;
    if (point_number < 1 || point_number > textTier->points.size) {
        Rcpp::stop("Point number out of range");
    }
    TextPoint point = textTier->points.at [point_number];
    const char32* text = point->mark.get();
    
    // Convert char32 to UTF-8
    std::string result;
    if (text) {
        for (const char32* p = text; *p; p++) {
            char32 c = *p;
            if (c < 0x80) {
                result += static_cast<char>(c);
            } else if (c < 0x800) {
                result += static_cast<char>(0xC0 | (c >> 6));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else if (c < 0x10000) {
                result += static_cast<char>(0xE0 | (c >> 12));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else {
                result += static_cast<char>(0xF0 | (c >> 18));
                result += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            }
        }
    }
    return result;
}

