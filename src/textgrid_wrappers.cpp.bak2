// ============================================================================
// Tier Type Queries
// ============================================================================

// [[Rcpp::export(.textgrid_is_interval_tier)]]
bool textgrid_is_interval_tier(Rcpp::XPtr<structTextGrid> xptr, int tier_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    return Thing_isa(tier, classIntervalTier);
}

// [[Rcpp::export(.textgrid_tier_class_name)]]
std::string textgrid_tier_class_name(Rcpp::XPtr<structTextGrid> xptr, int tier_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    const char32* className = Thing_className(tier);
    
    // Convert char32 to UTF-8
    std::string result;
    for (const char32* p = className; *p; p++) {
        char32 c = *p;
        if (c < 0x80) {
            result += static_cast<char>(c);
        } else if (c < 0x800) {
            result += static_cast<char>(0xC0 | (c >> 6));
            result += static_cast<char>(0x80 | (c & 0x3F));
        } else if (c < 0x10000) {
            result += static_cast<char>(0xE0 | (c >> 12));
            result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
            result += static_cast<char>(0x80 | (c & 0x3F));
        } else {
            result += static_cast<char>(0xF0 | (c >> 18));
            result += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
            result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
            result += static_cast<char>(0x80 | (c & 0x3F));
        }
    }
    return result;
}

// [[Rcpp::export(.textgrid_get_tier_name)]]
std::string textgrid_get_tier_name(Rcpp::XPtr<structTextGrid> xptr, int tier_number) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    Function tier = xptr->tiers->at [tier_number];
    const char32* name = tier->name.get();
    
    // Convert char32 to UTF-8
    std::string result;
    if (name) {
        for (const char32* p = name; *p; p++) {
            char32 c = *p;
            if (c < 0x80) {
                result += static_cast<char>(c);
            } else if (c < 0x800) {
                result += static_cast<char>(0xC0 | (c >> 6));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else if (c < 0x10000) {
                result += static_cast<char>(0xE0 | (c >> 12));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            } else {
                result += static_cast<char>(0xF0 | (c >> 18));
                result += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
                result += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
                result += static_cast<char>(0x80 | (c & 0x3F));
            }
        }
    }
    return result;
}

// [[Rcpp::export(.textgrid_set_tier_name)]]
void textgrid_set_tier_name(Rcpp::XPtr<structTextGrid> xptr, int tier_number, std::string new_name) {
    if (!xptr) Rcpp::stop("Invalid TextGrid pointer");
    if (tier_number < 1 || tier_number > xptr->tiers->size) {
        Rcpp::stop("Tier number out of range");
    }
    try {
        Function tier = xptr->tiers->at [tier_number];
        Thing_setName(tier, Melder_peek8to32(new_name.c_str()));
    } catch (MelderError) {
        Melder_clearError();
        Rcpp::stop("Failed to set tier name");
    }
}

