# Makevars.in for Unix/Linux/macOS builds
# Processed by configure script to generate Makevars

# Use C++17 standard
CXX_STD = CXX17

# Include directories
# Note: xsimd provided by RcppXsimd package (via LinkingTo in DESCRIPTION),
# so -DHAVE_XSIMD is unconditional: without RcppXsimd the build cannot run at all.
# GSL headers detected by configure via gsl-config / pkg-config
# -D_LIBCPP_DISABLE_DEPRECATION_WARNINGS: silences libc++'s C++17
# allocator-member deprecation attributes triggered inside the RcppXsimd
# headers (third-party, not patchable here); inert on libstdc++.
PKG_CPPFLAGS = -DHAVE_XSIMD -DPLADDRR_NO_DEBUG -DPLADDRR_FULL_PRAAT \
               -D_LIBCPP_DISABLE_DEPRECATION_WARNINGS -I. \
               -Ipocketfft \
               @GSL_CFLAGS@ \
               -Ipraat.github.io \
               -Ipraat.github.io/kar \
               -Ipraat.github.io/melder \
               -Ipraat.github.io/sys \
               -Ipraat.github.io/dwsys \
               -Ipraat.github.io/dwtools \
               -Ipraat.github.io/stat \
               -Ipraat.github.io/fon \
               -Ipraat.github.io/foned \
               -Ipraat.github.io/LPC \
               -Ipraat.github.io/sensors \
               -Ipraat.github.io/external/portaudio \
               -Ipraat.github.io/external/flac \
               -Ipraat.github.io/external/mp3 \
               -Ipraat.github.io/external/espeak \
               -Ipraat.github.io/external/gsl \
               -Ipraat.github.io/external/glpk \
               -Ipraat.github.io/external/num \
               -Iclapack/INCLUDE

# Compiler flags
# Note: R's own Makeconf provides optimization flags (-O2 typically).
# Do NOT add -O3, -flto, or -march=native — these violate CRAN policy.
# -ffp-contract=off is deliberate and required: it disables FMA contraction so
# the DSP output is bit-exact with the reference Praat application (the package's
# primary correctness guarantee). It is the one intentional non-portable flag;
# see cran-comments.md. All -Wno-* warning suppressions were removed for CRAN.
PKG_CXXFLAGS = -DPRAAT_LIB \
               -DNO_GUI \
               -DNO_AUDIO \
               -DNO_GRAPHICS \
               -DNO_NETWORK \
               -DUNIX \
               -DPLADDRR_NO_DEBUG \
               -pthread \
               -ffp-contract=off

# Linker flags — GSL detected by configure, LAPACK/BLAS from R
PKG_LIBS = @GSL_LIBS@ $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -pthread

