# Makevars.in for Unix/Linux/macOS builds
# Processed by configure script

# Use C++17 standard
CXX_STD = CXX17

# Include directories
# Note: xsimd from Homebrew for SIMD support
PKG_CPPFLAGS =  -DHAVE_XSIMD -DPLADDRR_NO_DEBUG -DPLADDRR_FULL_PRAAT -I. \
               -I/opt/homebrew/include \
               -Igsl-2.8 \
               -Igsl-2.8/gsl \
               -Ipraat.github.io \
               -Ipraat.github.io/kar \
               -Ipraat.github.io/melder \
               -Ipraat.github.io/sys \
               -Ipraat.github.io/dwsys \
               -Ipraat.github.io/dwtools \
               -Ipraat.github.io/stat \
               -Ipraat.github.io/fon \
               -Ipraat.github.io/foned \
               -Ipraat.github.io/LPC \
               -Ipraat.github.io/sensors \
               -Ipraat.github.io/external/portaudio \
               -Ipraat.github.io/external/flac \
               -Ipraat.github.io/external/mp3 \
               -Ipraat.github.io/external/espeak \
               -Ipraat.github.io/external/gsl \
               -Ipraat/external/gsl \
               -Ipraat.github.io/external/glpk \
               -Ipraat/external/glpk \
               -Ipraat.github.io/external/num \
               -Ipraat/external/num \
               -Iclapack/INCLUDE

# Compiler flags
PKG_CXXFLAGS =  -DPRAAT_LIB \
               -DNO_GUI \
               -DNO_AUDIO \
               -DNO_GRAPHICS \
               -DNO_NETWORK \
               -DUNIX \
               -DPLADDRR_NO_DEBUG \
               -pthread \
               -ffp-contract=off \
               -Wno-unused-parameter \
               -Wno-sign-compare \
               -Wno-unused-variable \
               -Wno-deprecated-declarations \
               -Wno-trigraphs \
               -Wno-logical-op-parentheses \
               -Wno-shift-op-parentheses \
               -Wno-mismatched-tags \
               -Wno-unused-const-variable \
               -Wno-c++11-narrowing

# Performance optimization flags
PKG_CXXFLAGS += -O3

# Platform-specific SIMD flags
# Detect platform and set appropriate flags
UNAME_M := $(shell uname -m 2>/dev/null || echo unknown)

# Platform-specific optimizations (enabled for local builds)
# NOTE: Comment these out before CRAN submission
ifeq ($(UNAME_M),x86_64)
  PKG_CXXFLAGS += -march=native -mtune=native -mfpmath=sse
else
  ifeq ($(UNAME_M),aarch64)
    PKG_CXXFLAGS += -march=armv8-a+simd
  else
    ifeq ($(UNAME_M),arm64)
      PKG_CXXFLAGS += -march=armv8-a+simd
    endif
  endif
endif

# Linker flags - link against GSL, R's LAPACK and BLAS
# Override FLIBS to use Homebrew gfortran if /opt/gfortran doesn't exist
HOMEBREW_GCC := $(shell brew --prefix gcc 2>/dev/null)
ifneq ($(HOMEBREW_GCC),)
  ifeq ($(wildcard /opt/gfortran),)
    # Use Homebrew gfortran location
    FLIBS_OVERRIDE = -L$(HOMEBREW_GCC)/lib/gcc/current -lgfortran -lquadmath
    PKG_LIBS = -L. -L/opt/homebrew/lib -lgsl -lgslcblas $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS_OVERRIDE) -pthread
  else
    PKG_LIBS = -L. -L/opt/homebrew/lib -lgsl -lgslcblas $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -pthread
  endif
else
  PKG_LIBS = -L. -L/opt/homebrew/lib -lgsl -lgslcblas $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -pthread
endif

